# Database (docker compose up -d)
DATABASE_URL="postgresql://englearn:englearn@localhost:5433/englearn"

# Encrypts API keys saved from the Settings page. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_SECRET=""

# AI providers — defaults; keys and models can also be set in Settings (those override these)
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
# Optional: any OpenAI-compatible endpoint (OpenRouter, Groq, Ollama, ...)
OPENAI_BASE_URL=""

# Model routing per role, format "provider:model" (provider = anthropic | openai)
AI_TUTOR="anthropic:claude-opus-5"
AI_GRADER="anthropic:claude-haiku-4-5"
AI_GENERATOR="anthropic:claude-opus-5"

# Background jobs (Inngest). Locally: 1 = use the dev server at http://localhost:8288 (started by `pnpm dev`)
INNGEST_DEV=1

# Web push for streak reminders — generate with `pnpm vapid`
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:reminders@example.com"

# Accounts (optional). Leave BETTER_AUTH_SECRET empty to keep single-user mode.
# Generate a secret: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# The first account created takes over the single-user data and becomes admin.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
ADMIN_EMAILS=""

# Daily AI request limits (only enforced when accounts are on)
FREE_DAILY_AI_REQUESTS=150
PRO_DAILY_AI_REQUESTS=2000

# Billing (optional): Stripe secret key, the Pro recurring price id, and the webhook signing secret
STRIPE_SECRET_KEY=""
STRIPE_PRICE_PRO=""
STRIPE_WEBHOOK_SECRET=""

# Voice: "openai" (server STT/TTS, needs OPENAI_API_KEY) or "browser" (Web Speech API)
VOICE_PROVIDER="browser"
